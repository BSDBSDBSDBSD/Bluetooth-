<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1923">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="#1A2535">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁 סייר קבצים Bluetooth"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Root status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:margin="16dp"
        android:padding="14dp"
        android:background="@drawable/card_bg"
        android:layout_margin="16dp">
        <TextView
            android:id="@+id/tvRootStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="בודק הרשאות Root..."
            android:textSize="14sp"
            android:textColor="#CCCCCC"/>
        <Switch
            android:id="@+id/switchRoot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Root"
            android:textColor="#FFFFFF"
            android:thumbTint="#1DB954"
            android:trackTint="#0D5C28"/>
    </LinearLayout>

    <!-- Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">
        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/dot_red"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="שרת כבוי"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnStartServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:text="הפעל שרת"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#1DB954"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="התחבר למכשיר אחר"
        android:textSize="16sp"
        android:backgroundTint="#2563EB"
        android:textColor="#FFFFFF"/>

    <!-- Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:padding="14dp"
        android:background="@drawable/card_bg">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="הוראות שימוש:"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="6dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. במכשיר הנגיש: לחץ על הפעל שרת\n2. במכשיר המדפדף: לחץ על התחבר\n3. בחר את המכשיר מהרשימה\n4. תיפתח גישה לקבצים"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>

</LinearLayout>
