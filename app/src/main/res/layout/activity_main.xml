<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/bg_app">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_header_gradient">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/icon_bg"
            android:text="📂"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginEnd="14dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סייר קבצים"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="גישה לקבצים במכשיר מרוחק"
                android:textSize="12sp"
                android:textColor="#D1FAE5"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/icon_bg"
            android:tint="#FFFFFF"
            android:padding="10dp"
            android:contentDescription="הגדרות"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_red"
                    android:layout_marginEnd="12dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="שרת כבוי"
                        android:textColor="#F1F5F9"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvStatusSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הפעל כדי לאפשר גישה למכשיר זה"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Root Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מצב Root"
                        android:textColor="#F1F5F9"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tvRootStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="בודק הרשאות..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <Switch
                    android:id="@+id/switchRoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:thumbTint="#22C55E"
                    android:trackTint="#1A3A1A"/>
            </LinearLayout>

            <!-- Enable radios -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btnEnableBt"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="📶 בלוטוס + גלוי"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#334155"
                    app:cornerRadius="14dp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnEnableWifi"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="📡 הפעל WiFi"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#334155"
                    app:cornerRadius="14dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <!-- Section: Server -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שרת"
                android:textSize="11sp"
                android:textColor="#34D399"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <Button
                android:id="@+id/btnStartServer"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="הפעל שרת (מכשיר נגיש)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#16A34A"
                android:textColor="#FFFFFF"
                app:cornerRadius="18dp"
                android:layout_marginBottom="22dp"/>

            <!-- Section: Connect -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="התחברות למכשיר אחר"
                android:textSize="11sp"
                android:textColor="#34D399"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <Button
                android:id="@+id/btnConnect"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🔵  התחבר דרך Bluetooth"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#3B82F6"
                android:textColor="#FFFFFF"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btnConnectWifi"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🌐  התחבר דרך WiFi ישיר"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#7C3AED"
                android:textColor="#FFFFFF"
                app:cornerRadius="16dp"
                android:layout_marginBottom="22dp"/>

            <!-- Instructions Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הוראות"
                android:textSize="11sp"
                android:textColor="#34D399"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/card_bg"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1.  במכשיר שרוצים לגשת אליו: הפעל שרת"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2.  במכשיר המדפדף: התחבר דרך Bluetooth או WiFi"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3.  בחר מכשיר מהרשימה"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4.  גלוש, העתק והורד קבצים"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Credit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="נבנה על ידי ‎@בסדבסד · מתמחים טופ · בעזרת Claude"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
