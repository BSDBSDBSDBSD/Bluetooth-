<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Files Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="קבצים"
            android:textSize="12sp"
            android:textColor="#22C55E"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Download path -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="תיקיית הורדות"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tvDownloadPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A3A" android:layout_marginBottom="12dp"/>

            <!-- Show hidden -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הצג קבצים מוסתרים"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="קבצים שמתחילים ב-."
                        android:textColor="#888888"
                        android:textSize="12sp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switchShowHidden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#22C55E"
                    android:trackTint="#1A3A1A"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A3A" android:layout_marginVertical="8dp"/>

            <!-- Overwrite -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="החלף קבצים קיימים"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="בהורדה — כתוב מעל קובץ קיים"
                        android:textColor="#888888"
                        android:textSize="12sp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switchOverwrite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#22C55E"
                    android:trackTint="#1A3A1A"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#2A2A3A" android:layout_marginVertical="8dp"/>

            <!-- Confirm delete -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אישור לפני מחיקה"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="שאל לפני מחיקת קובץ מרחוק"
                        android:textColor="#888888"
                        android:textSize="12sp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switchConfirmDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#22C55E"
                    android:trackTint="#1A3A1A"/>
            </LinearLayout>

        </LinearLayout>

        <!-- View Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="תצוגה"
            android:textSize="12sp"
            android:textColor="#22C55E"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="מיון קבצים"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="8dp"/>
            <Spinner
                android:id="@+id/spinnerSort"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/card_bg"
                android:popupBackground="#1A1A2E"/>

        </LinearLayout>

        <!-- Connection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="חיבור"
            android:textSize="12sp"
            android:textColor="#22C55E"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="timeout חיבור"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="8dp"/>
            <Spinner
                android:id="@+id/spinnerTimeout"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/card_bg"
                android:popupBackground="#1A1A2E"/>

        </LinearLayout>

        <!-- Credit Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/icon_bg"
                android:text="⚡"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="נבנה על ידי ‎@בסדבסד"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מתמחים טופ · בעזרת Claude"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סייר קבצים · גרסה 1.1"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
